% Last Modified by GUIDE v2.5 10-Nov-2012 15:55:40

% Begin initialization code - DO NOT EDIT
gui_Singleton = 1;
gui_State = struct('gui_Name',       mfilename, ...
                   'gui_Singleton',  gui_Singleton, ...
                   'gui_OpeningFcn', @OA_Valentia_OpeningFcn, ...
                   'gui_OutputFcn',  @OA_Valentia_OutputFcn, ...
                   'gui_LayoutFcn',  [] , ...
                   'gui_Callback',   []);
