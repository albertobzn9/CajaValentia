% --- Executes on button press in pushbutton1.
function pushbutton1_Callback(hObject, eventdata, handles)
% hObject    handle to pushbutton1 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

pausa=0;
detener=0;
save('c:\control','pausa','detener');

TEnsayos=str2num(get(handles.edit1,'String'));

Resul=[];


for i=1:5 %TEnsayos
    guidata(hObject, handles);
    i
    pause(.11)
    Resul=[Resul;rand(1,3)];
    set(handles.htabla,'Data',Resul);
    
 %   OA_ValentiaPalanca(handles.OA,'D',1); 
    
  %  OA_ValentiaEstimulo(handles.OA,'I',0,0)
   
   OA_ValentiaRecompensa(handles.OA,'D',1)
   pause(.5)
   OA_ValentiaRecompensa(handles.OA,'D',2)
   
   
%OA_ValentiaPalanqueo(handles.OA,'I',0,10)    
%     if(i==1)
%     OA_ValentiaPalanca(handles.OA,'D',1);    
%     
%      OA_ValentiaEstimulo(handles.OA,'D',1,1)
%      pause(5)
%      OA_ValentiaEstimulo(handles.OA,'D',0,0)
% 
%     %OA_ValentiaPalanqueo(handles.OA,'I',0,50)
%     
%     OA_ValentiaPalanca(handles.OA,'D',2);  
%     
%     end
%     
%      if(i==1)
%     OA_ValentiaPalanca(handles.OA,'I',1);    
%     
%      OA_ValentiaEstimulo(handles.OA,'I',1,1)
%      pause(2)
%      OA_ValentiaEstimulo(handles.OA,'I',0,0)
% 
%     %OA_ValentiaPalanqueo(handles.OA,'I',0,50)
%     
%     OA_ValentiaPalanca(handles.OA,'I',2);  
%     
 %   end
 
  % [Lugar,Lado]=OA_ValentiaPosicion(handles.OA)
      
    
    load('c:\control')
    if(detener==0)
     if(pausa==1)
         while(pausa==1)
             pause(.5)
             load('c:\control')
         end    
     end  
    end
    if(detener==1)
        [nomSalvar,ruta] = uiputfile('*.mat', 'Guardar datos en');
        break
    end    
end    
%set(handles.htabla,'Data',rand(i,3));




% --- Executes on button press in pushbutton2.
function pushbutton2_Callback(hObject, eventdata, handles)
% hObject    handle to pushbutton2 (see GCBO)
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)

load('c:\control')
if(pausa==0)
pausa=1;
save('c:\control','pausa','detener');
set(hObject,'String','Continuar');
return
end
if(pausa==1)
pausa=0;
save('c:\control','pausa','detener');
set(hObject,'String','Pausa');
return
end

