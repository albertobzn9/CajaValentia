% --- Executes just before valentia is made visible.
function valentia_OpeningFcn(hObject, eventdata, handles, varargin)
% This function has no output args, see OutputFcn.
% hObject    handle to figure
% eventdata  reserved - to be defined in a future version of MATLAB
% handles    structure with handles and user data (see GUIDATA)
% varargin   command line arguments to valentia (see VARARGIN)

% Choose default command line output for valentia
handles.output = hObject;

% Update handles structure
guidata(hObject, handles);

% UIWAIT makes valentia wait for user response (see UIRESUME)
% uiwait(handles.figure1);



handles.htabla = uitable('Units', 'normalized','Position', [0.025 0.03 0.9 0.5]);
set(handles.htabla,'Data',rand(1,3));
detener=0;
pausa=0;
save('c:\control','pausa','detener');

handles.TEnsayos=1000;
handles.PorcRiesgo=.5;
handles.Pausa=0;
handles.Detener=0;


daqreset

handles.OA = OA_ValentiaInicio;

guidata(hObject, handles);



